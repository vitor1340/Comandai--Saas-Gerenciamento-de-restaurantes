# apps/api/.env
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET="dev-only-change-me"
# Curto de propósito: o access token não pode ser revogado antes de expirar,
# então o TTL curto limita a janela de exposição. Sessões longas vêm do
# refresh token (REFRESH_TOKEN_TTL_DIAS), que é revogável.
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DIAS=30
PORT=3001
# Também usado como base do back_url da assinatura Comandaí (preapproval do
# Mercado Pago, ver assinaturas.service.ts) — o Mercado Pago REJEITA back_url
# em http://localhost (erro "Invalid value for back_url"), então testar o
# fluxo de "Assinar Pro" localmente exige expor o front por HTTPS também
# (ex.: ngrok, igual já se faz pra URL_PUBLICA_API), não só localhost:3000.
CORS_ORIGIN="http://localhost:3000"
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"
SUPABASE_STORAGE_BUCKET="comandai"
GOOGLE_CLIENT_ID="seu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"
RESEND_API_KEY="re_sua_chave"
# Em sandbox (sem domínio verificado no Resend), só entrega para o
# e-mail da própria conta Resend usada para gerar a API key.
RESEND_FROM_EMAIL="Comandaí <onboarding@resend.dev>"
# URL pública onde a API roda, usada para montar a URL de callback do OAuth
# e a notification_url do webhook do Mercado Pago. Em dev local aponta pro
# próprio localhost; em produção precisa ser uma URL HTTPS acessível de fora.
URL_PUBLICA_API="http://localhost:3001/api"
# Credenciais da aplicação criada em developers.mercadopago.com (não confundir
# com o access token de cada restaurante, que é obtido via OAuth Connect e
# fica salvo, criptografado, no banco).
MERCADOPAGO_CLIENT_ID="seu-client-id"
MERCADOPAGO_CLIENT_SECRET="seu-client-secret"
MERCADOPAGO_ACCESS_TOKEN="seu-access-token-da-aplicacao"
# Assinatura secreta configurada em "Webhooks" no painel da aplicação, usada
# para validar que as notificações realmente vêm do Mercado Pago. Cobre tanto
# o webhook de pagamento de pedidos (/pagamentos/webhook) quanto o webhook de
# assinatura da própria plataforma (/assinaturas/webhook, tópico
# subscription_preapproval) — mesma aplicação, mesmo segredo.
# Com credenciais de TESTE (TEST-...), só é possível pagar com os cartões de
# teste do Mercado Pago e o restaurante conectado também precisa ser uma
# conta de teste — contas reais não completam a conexão OAuth em modo teste.
# O webhook (notification_url) só é alcançável se URL_PUBLICA_API for uma URL
# pública de verdade (em produção, HTTPS) — em dev local, use algo como ngrok
# para o Mercado Pago conseguir chamar de volta. Diferente do webhook de
# pagamentos, a notificação de assinatura (/assinaturas/webhook) precisa ser
# configurada manualmente no painel do Mercado Pago (tópico
# subscription_preapproval) — a API de preapproval não aceita notification_url
# por requisição.
MERCADOPAGO_WEBHOOK_SECRET="sua-assinatura-secreta-de-webhook"
# Chave de 32 bytes em hex (64 caracteres) usada para criptografar os tokens
# do Mercado Pago de cada restaurante antes de salvar no banco. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY="chave-hex-de-64-caracteres"
# Captcha (Cloudflare Turnstile) no cadastro, login e "esqueci a senha".
# Obrigatório em produção (a API não sobe sem). Fora de produção, sem a
# chave a verificação é pulada. Chaves de teste da Cloudflare (sempre
# passam): secret 1x0000000000000000000000000000000AA, site key
# 1x00000000000000000000AA.
TURNSTILE_SECRET_KEY=""
# Segredo compartilhado com o apps/web: as rotas de auth do Next repassam o
# IP real do cliente num header, que a API só aceita junto com este segredo
# (senão o rate limit por IP vira global — ver common/client-ip.util.ts).
# Mesmo valor nos dois apps. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_PROXY_SECRET=""
# NÃO usar em produção com cobrança ativa. "true" desliga o bloqueio por
# plano vencido/cancelado (ContaLiberadaGuard e loja pública) — foi o
# interruptor usado antes da cobrança ser ligada. Sem a variável, a
# cobrança vale normalmente.
# DESATIVAR_BLOQUEIO_PLANO="true"

# apps/web/.env.local
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
# Site key do Cloudflare Turnstile (pública). Vazio = captcha desligado.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Mesmo valor do INTERNAL_PROXY_SECRET da API.
INTERNAL_PROXY_SECRET=""
