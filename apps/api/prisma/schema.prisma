generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PlanoRestaurante {
  FREE
  PRO
}

// PAST_DUE e CANCELED vêm do webhook de assinatura do Mercado Pago (ver
// mapearStatusAssinaturaMercadoPago em assinaturas.service.ts).
enum StatusAssinatura {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum FaixaAssinatura {
  ATE_150
  DE_151_A_250
  ACIMA_250
}

enum CargoUsuario {
  DONO
  GERENTE
  ATENDENTE
}

enum CanalVenda {
  CARDAPIO_DIGITAL
  WHATSAPP
  QR_CODE_SALAO
}

enum TipoEntrega {
  DELIVERY
  RETIRADA
  SALAO
}

enum TipoAtendimento {
  DELIVERY_E_FISICA
  SOMENTE_DELIVERY
  SOMENTE_FISICA
}

enum StatusPedido {
  NOVO
  CONFIRMADO
  EM_PREPARO
  PRONTO
  SAIU_PARA_ENTREGA
  ENTREGUE
  CANCELADO
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
  CANCELADO
}

model Restaurante {
  id                   String           @id @default(uuid())
  nome                 String
  slug                 String           @unique
  plano                PlanoRestaurante @default(FREE)
  statusAssinatura     StatusAssinatura @default(TRIALING)
  trialEndsAt          DateTime         @default(dbgenerated("(now() + interval '7 days')"))
  aberto               Boolean          @default(true)
  whatsapp             String?
  tagline              String?
  logoUrl              String?
  corDestaque          String?
  tipoAtendimento      TipoAtendimento  @default(DELIVERY_E_FISICA)
  endereco             String?
  horarioFuncionamento String?
  diferenciais         String[]         @default([])
  // CPF (11) ou CNPJ (14), só dígitos. Único pra impedir o mesmo dono de
  // abrir vários restaurantes só pra renovar o teste grátis. Nulo em
  // cadastros via Google até o onboarding (ContaLiberadaGuard bloqueia
  // escrita enquanto estiver nulo).
  documento            String?          @unique
  suspensoEm           DateTime?
  ipCadastro           String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  mercadoPagoAccessToken  String?
  mercadoPagoRefreshToken String?
  mercadoPagoUserId       String?
  mercadoPagoConectadoEm  DateTime?
  mercadoPagoTokenExpiraEm DateTime?

  // Assinatura da PRÓPRIA plataforma (o restaurante pagando o Comandaí) —
  // não confundir com os campos mercadoPago* acima, que são a conta do
  // restaurante conectada via OAuth pra receber pagamento dos pedidos.
  mercadoPagoPreapprovalId String?
  faixaAssinatura          FaixaAssinatura?

  usuarios          Usuario[]
  categorias        Categoria[]
  produtos          Produto[]
  pedidos           Pedido[]
  eventosAssinatura EventoAssinatura[]
}

// Log bruto de cada notificação de webhook de assinatura recebida do
// Mercado Pago — histórico de auditoria pra investigar problemas de
// cobrança depois do fato (não é consultado no caminho normal da aplicação).
model EventoAssinatura {
  id            String      @id @default(uuid())
  restauranteId String
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id])
  tipo          String
  payloadBruto  Json
  createdAt     DateTime    @default(now())

  @@index([restauranteId, createdAt])
}

model Usuario {
  id                       String                    @id @default(uuid())
  nome                     String
  email                    String                    @unique
  senhaHash                String?
  googleId                 String?                   @unique
  emailVerificadoEm        DateTime?
  // Admin da plataforma (dono do Comandaí), não do restaurante. Só é setado
  // direto no banco — não existe rota que promova alguém.
  superAdmin               Boolean                   @default(false)
  cargo                    CargoUsuario              @default(DONO)
  restauranteId            String
  restaurante              Restaurante               @relation(fields: [restauranteId], references: [id])
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  tokensRedefinicaoSenha   TokenRedefinicaoSenha[]
  tokensVerificacaoEmail   TokenVerificacaoEmail[]
  refreshTokens            RefreshToken[]
  doisFatoresAtivo         Boolean                   @default(false)
  totpSecret               String?
  codigosBackupDoisFatores CodigoBackupDoisFatores[]
}

model CodigoBackupDoisFatores {
  id         String    @id @default(uuid())
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  codigoHash String    @unique
  usadoEm    DateTime?
  createdAt  DateTime  @default(now())

  @@index([usuarioId])
}

model TokenRedefinicaoSenha {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiraEm  DateTime
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

model TokenVerificacaoEmail {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiraEm  DateTime
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

// Sem relação com Usuario de propósito: precisa contar tentativas mesmo
// contra e-mails que não existem (senão a trava viraria mais um jeito de
// descobrir por timing/erro se um e-mail está cadastrado).
model TentativaLoginFalha {
  id       String   @id @default(uuid())
  email    String
  criadoEm DateTime @default(now())

  @@index([email, criadoEm])
}

model RefreshToken {
  id                      String    @id @default(uuid())
  usuarioId               String
  usuario                 Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash               String    @unique
  criadoEm                DateTime  @default(now())
  expiraEm                DateTime
  revogadoEm              DateTime?
  substituidoPorTokenHash String?
  userAgent               String?
  ip                      String?

  @@index([usuarioId])
}

model Categoria {
  id            String      @id @default(uuid())
  restauranteId String
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id])
  nome          String
  // Gerado no backend a partir do nome (ver common/slugify.util.ts) — não é
  // input direto do cliente. Único por loja, não globalmente (multi-tenant).
  slug          String
  ordem         Int         @default(0)
  ativa         Boolean     @default(true)
  produtos      Produto[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([restauranteId, slug])
}

model Produto {
  id            String       @id @default(uuid())
  restauranteId String
  restaurante   Restaurante  @relation(fields: [restauranteId], references: [id])
  // Opcional de propósito: excluir uma categoria nunca apaga produtos em
  // cascata — eles são movidos para outra categoria ou ficam sem categoria
  // (ver CategoriasService.remover). onDelete: SetNull é só uma rede de
  // segurança pro caso de alguém excluir a categoria fora desse fluxo.
  categoriaId   String?
  categoria     Categoria?   @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  nome          String
  descricao     String?
  precoCentavos Int
  imagemUrl     String?
  disponivel    Boolean      @default(true)
  destaque      Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  itensPedido   ItemPedido[]
}

model Pedido {
  id                  String       @id @default(uuid())
  restauranteId       String
  restaurante         Restaurante  @relation(fields: [restauranteId], references: [id])
  numero               Int
  clienteNome          String
  canal                CanalVenda
  tipoEntrega          TipoEntrega
  status               StatusPedido @default(NOVO)
  valorTotalCentavos   Int
  tempoPreparoMinutos  Int?
  chaveIdempotencia    String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  itens                ItemPedido[]
  pagamento            Pagamento?

  @@unique([restauranteId, numero])
  @@unique([restauranteId, chaveIdempotencia])
  @@index([restauranteId, createdAt])
  @@index([restauranteId, status])
}

model ItemPedido {
  id                    String  @id @default(uuid())
  pedidoId              String
  pedido                Pedido  @relation(fields: [pedidoId], references: [id])
  produtoId             String
  produto               Produto @relation(fields: [produtoId], references: [id])
  quantidade            Int
  precoUnitarioCentavos Int
  observacao            String?
}

model Pagamento {
  id                   String          @id @default(uuid())
  pedidoId             String          @unique
  pedido               Pedido          @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  preferenceId         String
  mercadoPagoPaymentId String?
  initPoint            String
  status               StatusPagamento @default(PENDENTE)
  metodoPagamento      String?
  valorCentavos        Int
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}
